// https://opencode.ai/docs/config
// run `opencode debug config` to resolve and show config
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "grep *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git status",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git diff*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git log*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git show*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "git *",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "glob *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tree *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "wc *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "find *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "head *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "tail *",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "rm *",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ]
}